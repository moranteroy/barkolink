# Supabase project settings. Publishable keys are safe for frontend use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use your project's legacy anon key.
VITE_SUPABASE_ANON_KEY=
# Never put a service-role key or database password in VITE_* variables.

# Optional Leaflet basemap provider. Empty uses OpenStreetMap standard tiles.
# Change both together when using another provider; use browser-safe credentials.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Optional operator contacts displayed on Help and Privacy.
# Leave blank until the operator supplies official details.
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=

# Weather uses Open-Meteo; no WeatherAPI key is required.
# See docs/weatherapi-setup.md for deployment and usage requirements.
