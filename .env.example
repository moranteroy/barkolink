# Supabase project settings. Publishable keys are safe for frontend use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use your project's legacy anon key.
VITE_SUPABASE_ANON_KEY=
# Never put a service-role key or database password in VITE_* variables.

# Optional: Maps Embed API browser key, restricted to your app URLs.
# Empty uses the public Google Maps embed and directions links.
VITE_GOOGLE_MAPS_API_KEY=

# Optional operator contacts displayed on Help and Privacy.
# Leave blank until the operator supplies official details.
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=

# WeatherAPI key belongs in Supabase Edge Function secrets, never in VITE_*.
# Use the ignored .env.weather.local setup file; see docs/weatherapi-setup.md.
