# Copy to .env.local and fill these values from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase SQL Connect service settings (provided by the project owner).
VITE_SQL_CONNECT_LOCATION=asia-southeast1
VITE_SQL_CONNECT_SERVICE=barkolink-87e5e-service
VITE_SQL_CONNECT_CONNECTOR=passenger
