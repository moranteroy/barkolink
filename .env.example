# Supabase project settings. Publishable keys are safe for frontend use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use your project's legacy anon key.
VITE_SUPABASE_ANON_KEY=
# Never put a service-role key or database password in VITE_* variables.

# Optional: Maps Embed API browser key, restricted to your app URLs.
# Empty uses the public Google Maps embed and directions links.
VITE_GOOGLE_MAPS_API_KEY=
