# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

.idea/
.ionic/
.sass-cache/
.sourcemaps/
.versions/
/.vscode/*
!/.vscode/extensions.json
coverage/
dist/
node_modules/
/platforms
/plugins
/www
.env*
!.env.example
.firebase-config/
.firebase/
.supabase/
.vercel/
.backups/
.audit/
/supabase/.temp/
**/.secret.local

# Local caches, credentials, and signing material
.npm-cache/
.cache/
.aws/
.ssh/
.codex/
.agents/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
*-service-account.json
*firebase-adminsdk*.json
credentials.json

# Generated browser verification output
/docs/screenshots/
/cypress/screenshots/
/cypress/videos/
/cypress/downloads/
/tests/e2e/screenshots/
/tests/e2e/videos/
/tests/e2e/downloads/
/test-results/
/playwright-report/
*.tsbuildinfo

# Archived Firebase code and prototypes are kept only on the owner's machine.
/legacy/

# Native source and the Gradle wrapper stay in Git; build products stay local.
*.apk
*.aab
*.ap_
*.dex
*.hprof
.gradle/
.cxx/
.externalNativeBuild/
/android/**/build/
/android/local.properties
/android/.idea/
/android/capacitor-cordova-android-plugins/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
