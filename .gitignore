# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

.idea/
.ionic/
.sass-cache/
.sourcemaps/
.versions/
/.vscode/*
!/.vscode/extensions.json
coverage/
dist/
node_modules/
/platforms
/plugins
/www
.env*
.firebase-config/
.firebase/
.supabase/
.vercel/
.backups/
.audit/
/supabase/.temp/
**/.secret.local

# Local caches, credentials, and signing material
.npm-cache/
.cache/
.aws/
.ssh/
.codex/
.agents/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
*-service-account.json
*firebase-adminsdk*.json
credentials.json

# Generated browser verification output
/docs/screenshots/
# Unused mascot design draft; keep only the active guide assets in Git.
/public/images/mascot/barkolink-captain-female-anime-v1.png
/cypress/screenshots/
/cypress/videos/
/cypress/downloads/
/tests/e2e/screenshots/
/tests/e2e/videos/
/tests/e2e/downloads/
/test-results/
/playwright-report/
*.tsbuildinfo

# Archived Firebase code and prototypes are kept only on the owner's machine.
/legacy/

# Native source and the Gradle wrapper stay in Git; build products stay local.
*.apk
*.aab
*.ap_
*.dex
*.hprof
.gradle/
.cxx/
.externalNativeBuild/
/android/**/build/
/android/local.properties
/android/.idea/
/android/capacitor-cordova-android-plugins/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml

# Academic manuscripts, Word documents and presentation screenshots stay local.
/docs/research/
*.[dD][oO][cC]
*.[dD][oO][cC][xXmM]
*.[dD][oO][tT]
*.[dD][oO][tT][xXmM]
**/[Cc]hapter[- _][123]*
**/[Cc]hapter[123]*
**/[Cc]haptee[- _][123]*
**/[Cc]haptee[123]*
**/[Bb]arko[Ll]ink-[Ff]eature-[Ss]creenshots*/
**/[Bb]arko[Ll]ink-[Ff]eature-[Ss]creenshots*.zip
**/[Bb]arko[Ll]ink [Ff]eature [Ss]creenshots*/
**/[Bb]arko[Ll]ink [Ff]eature [Ss]creenshots*.zip
**/[Bb]arko[Ll]ink-[Ss]ystem-[Oo]verview*

# One-off local capture and rehearsal helpers; reusable app checks stay in Git.
/scripts/audit-current-*.mjs
/scripts/audit-database-suites.mjs
/scripts/audit-demo-browser.mjs
/scripts/audit-extra-browser.mjs
/scripts/audit-presentation-readiness.mjs
/scripts/capture-demo-accounts.mjs
/scripts/capture-system-overview.mjs
/scripts/package-system-screenshots.mjs
/scripts/rehearse-*.mjs
